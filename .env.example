# ============================================================
# VivaForge — environment variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit a file named ".env" with real secrets.
# ============================================================

# --- App ---
ENV=development
DEBUG=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# Local dev example (docker-compose service name "db"):
DATABASE_URL=postgresql+psycopg2://vivaforge:vivaforge@localhost:5432/vivaforge

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000

# --- LLM provider (Groq — free tier, no credit card required) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# --- Vector store (Chroma, local persistence) ---
CHROMA_PERSIST_DIR=./storage/chroma

# --- Media / storage ---
UPLOAD_DIR=./storage/uploads
ARTIFACT_DIR=./storage/artifacts
MAX_UPLOAD_SIZE_MB=500
ALLOWED_UPLOAD_EXTENSIONS=mp4,mp3,wav,pdf,ppt,pptx

# --- Whisper (faster-whisper) ---
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# ============================================================
# Frontend (frontend/.env.local)
# ============================================================
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
